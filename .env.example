# This front's public URL. It is the OAuth resource identifier MCP clients see,
# and its path is where they send requests.
PUBLIC_URL=https://front.example.com/mcp

# The Agent Gateway access-point route every request is forwarded to.
UPSTREAM_URL=https://example.agentgateway.affinidi.io/routes/my-mcp

# Your IdP. Compared to the token's `iss` exactly, so keep the trailing slash
# if your provider's issuer has one.
OIDC_ISSUER=https://idp.agentlab.choosemission.com/realms/mission-agent-lab

# Optional, recommended. If set, the token's `aud` must contain it. With
# Keycloak this is whatever the audience mapper emits, not PUBLIC_URL.
JWT_AUDIENCE=

# Scopes advertised to clients, comma-separated. With Keycloak, include the
# client scope that carries your audience mapper, or tokens arrive with no `aud`.
SCOPES=openid,email,offline_access

# Shown to clients and used in error messages.
RESOURCE_NAME=My MCP server

# Optional. Also forward the token under this header name, for a resource
# behind the Gateway that wants to see the caller.
FORWARD_TOKEN_HEADER=

# What the front tells the Gateway it accepts. JSON only, because the Gateway's
# SSE response path currently sends headers and no body.
UPSTREAM_ACCEPT=application/json

UPSTREAM_TIMEOUT_MS=30000

PORT=8080
